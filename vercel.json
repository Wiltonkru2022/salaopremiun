{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run ci:validate",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feat/operational-health-autonomy": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/operational-health",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/limpar-observabilidade",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/cron/renovar-assinaturas",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/security-cleanup",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/trial-alerts",
      "schedule": "0 12 * * *"
    }
  ]
}
