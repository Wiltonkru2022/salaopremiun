{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/notificacoes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/limpar-observabilidade",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/cron/renovar-assinaturas",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/security-cleanup",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/trial-alerts",
      "schedule": "0 12 * * *"
    }
  ]
}
