{
  "name": "salaopremiun-profissional-android",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "web:build": "npm --prefix ../../app-profissional-vite run build:android",
    "sync": "cap sync android",
    "prepare:android": "npm run web:build && npm run sync",
    "open": "cap open android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "aab:release": "cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  }
}
