{
  "name": "salaopremium",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "// desenvolvimento": "Rotina leve para codar e testar tela/fluxo",
    "dev": "next dev",
    "dev:inspect": "next dev --inspect",
    "build": "node scripts/run-build.mjs",
    "start": "next start",
    "// checagem local": "Checks rapidos, sem build nem auditorias longas",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "node scripts/run-typecheck.mjs",
    "typecheck:ci": "npm run typecheck",
    "typecheck:deps": "next typegen && node scripts/ensure-next-types.mjs && tsc -p tsconfig.ci.json --noEmit --incremental false",
    "typecheck:professional": "tsc -p apps/app-profissional-vite/tsconfig.app.json --noEmit",
    "build:professional": "npm --prefix apps/app-profissional-vite run build",
    "audit:text": "node scripts/audit/text-encoding-audit.mjs",
    "check": "npm run lint && npm run typecheck",
    "check:quick": "npm run lint",
    "backup:local": "node scripts/backup/create-local-backup.mjs",
    "backup:db:schema": "node scripts/backup/create-supabase-schema-backup.mjs",
    "backup:db:data": "node scripts/backup/create-supabase-data-backup.mjs",
    "backup:all:safe": "npm run backup:local && npm run backup:db:schema",
    "// CI": "Validacao deterministica para pull request",
    "ci:lint": "npm run lint",
    "ci:typecheck": "npm run typecheck:ci",
    "ci:audit": "npm run audit:security && npm run audit:service-role && npm run audit:admin-actions && npm run audit:admin-client-inventory && npm run audit:admin-surface && npm run audit:api-guards && npm run audit:critical-routes && npm run audit:no-wildcard-select && npm run audit:database-contract && npm run audit:architecture-boundaries && npm run audit:operational-coverage",
    "ci:build": "npm run build",
    "ci:validate": "npm run ci:lint && npm run ci:typecheck && npm run ci:audit && npm run test:operational && npm run ci:build",
    "// release": "Validacao pesada antes de promover producao",
    "release:validate": "npm run ci:validate && npm run e2e:proxy && npm run e2e:sales",
    "release:smoke": "npm run e2e:proxy && npm run e2e:sales",
    "// banco": "Auditoria de migrations, RPCs e contrato Supabase",
    "db:audit": "npm run audit:database-contract",
    "db:healthcheck": "npm run audit:database-contract",
    "// monitoramento": "Auditorias de seguranca operacional e observabilidade",
    "audit": "npm run audit:security",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:service-role": "node scripts/audit/service-role-audit.mjs",
    "audit:admin-actions": "node scripts/audit/admin-master-actions-audit.mjs",
    "audit:api-guards": "node scripts/audit/api-guard-audit.mjs",
    "audit:no-wildcard-select": "node scripts/audit/no-wildcard-select-audit.mjs",
    "audit:admin-surface": "node scripts/audit/admin-surface-audit.mjs",
    "audit:critical-routes": "node scripts/audit/critical-route-surface-audit.mjs",
    "audit:architecture-boundaries": "node scripts/audit/architecture-boundaries-audit.mjs",
    "audit:database-contract": "node scripts/audit/database-contract-audit.mjs",
    "audit:admin-client-inventory": "node scripts/audit/admin-client-inventory.mjs",
    "audit:launch-readiness": "node scripts/audit/launch-readiness-audit.mjs",
    "audit:operational-coverage": "node scripts/audit/operational-coverage-audit.mjs",
    "test:operational": "vitest run lib/monitoring/*.test.ts lib/client-app/deterministic-date.test.ts",
    "e2e:proxy": "node scripts/e2e/proxy-smoke.mjs",
    "e2e:sales": "node scripts/e2e/saas-sales-flow.mjs",
    "e2e:provision": "node scripts/e2e/provision-test-accounts.mjs",
    "e2e:playwright": "node scripts/e2e/playwright-full-smoke.mjs",
    "e2e:client-professional": "node scripts/e2e/app-client-professional-flow.mjs",
    "e2e:client-resilience": "node scripts/e2e/client-appointment-resilience-flow.mjs",
    "e2e:client-login-booking": "node scripts/e2e/client-login-during-booking-flow.mjs",
    "e2e:professional-offline": "node scripts/e2e/professional-offline-cache-flow.mjs",
    "e2e:signal-confirmation": "node scripts/e2e/signal-payment-confirmation-flow.mjs",
    "e2e:status": "node scripts/e2e/status-page-health-flow.mjs",
    "validate": "npm run ci:validate",
    "validate:release": "npm run release:validate",
    "launch:validate": "npm run lint && npm run typecheck && npm run db:audit && npm run audit:service-role && npm run audit:admin-actions && npm run audit:admin-client-inventory && npm run audit:admin-surface && npm run audit:api-guards && npm run audit:critical-routes && npm run audit:no-wildcard-select && npm run audit:architecture-boundaries && npm run audit:operational-coverage && npm run audit:launch-readiness && npm run test:operational && npm run build"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fabric": "^7.4.0",
    "firebase-admin": "^14.3.0",
    "iron-session": "^8.0.4",
    "jose": "^6.2.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.4",
    "openai": "^6.33.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.4",
    "globals": "^17.4.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.59.1",
    "supabase": "^2.98.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.12"
  }
}
